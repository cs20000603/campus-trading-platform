      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="基准测试-商品购买全流程" enabled="false">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
