page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'Segoe UI', Arial, Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 14px;
  color: #333;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

.container {
  padding: 0 15px;
}

/* 商品卡片网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 10px;
}

.goods-grid .goods-item {
  width: 48%;
  margin: 1%;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.goods-grid .goods-item .goods-image {
  width: 100%;
  height: 180px;
}

.goods-grid .goods-item .goods-info {
  padding: 10px;
}

.goods-grid .goods-item .goods-name {
  font-size: 14px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 6px;
}

.goods-grid .goods-item .goods-price {
  color: #ee0a24;
  font-size: 16px;
  font-weight: bold;
}

.goods-grid .goods-item .goods-sale {
  color: #999;
  font-size: 12px;
  margin-left: 6px;
}

/* 顶部占位 */
.status-bar-placeholder {
  height: 0;
}

/* 通用按钮 */
.btn-primary {
  background-color: #ee0a24;
  color: #fff;
  border: none;
  border-radius: 4px;
  padding: 10px 20px;
  font-size: 14px;
}

/* 价格样式 */
.price {
  color: #ee0a24;
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 12px;
}
