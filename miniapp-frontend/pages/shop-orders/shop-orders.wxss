.page {
  min-height: 100vh;
  background: #f5f5f5;
}
.empty-wrap {
  padding-top: 80rpx;
}
.order-list {
  padding: 20rpx 0;
}
.order-item {
  background: #fff;
  margin: 0 24rpx 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
}
.order-header {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fafafa;
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #f0f0f0;
}
.order-goods {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.goods-info {
  margin-left: 16rpx;
  flex: 1;
}
.goods-name {
  font-size: 28rpx;
  font-weight: 500;
}
.goods-price {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
}
.footer-info {
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}
.order-total {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.price {
  color: #f56c6c;
}
.order-actions {
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: right;
}
