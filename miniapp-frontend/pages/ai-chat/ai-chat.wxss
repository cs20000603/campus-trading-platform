.ai-chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

.mode-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}
.mode-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 0;
  margin: 0 8rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
}
.mode-item.active {
  background: #ee0a24;
  color: #fff;
}

.msg-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}
.msg-item {
  margin-bottom: 24rpx;
}
.msg-bubble {
  max-width: 85%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
.msg-user {
  background: #ee0a24;
  color: #fff;
  margin-left: auto;
  border-bottom-right-radius: 6rpx;
}
.msg-ai {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.input-field {
  flex: 1;
  height: 70rpx;
  background: #f5f5f5;
  border-radius: 35rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.send-btn {
  border-radius: 35rpx !important;
  height: 70rpx !important;
}
