.manage-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-top: 20rpx;
}
.shop-header {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  background: #fff;
  margin-bottom: 20rpx;
}
.shop-header-info {
  margin-left: 20rpx;
  flex: 1;
}
.shop-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.info-group {
  margin-bottom: 20rpx;
}
.action-wrap {
  padding: 0 32rpx;
  margin-top: 20rpx;
}
.edit-wrap {
  background: #fff;
  padding: 30rpx 0;
  margin-top: 20rpx;
}
.upload-wrap {
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  background: #fff;
}
.upload-label {
  font-size: 28rpx;
  color: #323233;
  margin-right: 20rpx;
}
.edit-title {
  font-size: 30rpx;
  font-weight: bold;
  padding: 0 32rpx 20rpx;
}
.edit-btns {
  padding: 30rpx 32rpx;
}
.tips {
  padding: 30rpx 32rpx;
  font-size: 28rpx;
  color: #ee9900;
  text-align: center;
  background: #fff9ed;
  margin: 20rpx 32rpx;
  border-radius: 8rpx;
}
.reject-box {
  margin: 20rpx 32rpx;
  padding: 30rpx;
  background: #fef0f0;
  border-radius: 8rpx;
  border-left: 8rpx solid #f56c6c;
}
.reject-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #f56c6c;
  margin-bottom: 10rpx;
}
.reject-reason {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
}
.empty-wrap {
  padding-top: 100rpx;
}
