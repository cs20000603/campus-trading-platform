.container { padding: 10px; padding-bottom: 80px; }
.filter-bar { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
.filter-tag { padding: 4px 10px; background: #f5f5f5; border-radius: 12px; font-size: 12px; }
.filter-tag.active { background: #1989fa; color: white; }
.goods-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.goods-card { width: calc(50% - 5px); background: white; border-radius: 8px; overflow: hidden; }
.goods-img { width: 100%; height: 160px; }
.goods-info { padding: 8px; }
.goods-title { font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-price { color: #ee0a24; font-size: 16px; font-weight: bold; }
.goods-original { color: #999; font-size: 11px; text-decoration: line-through; margin-left: 6px; }
.goods-tags { display: flex; gap: 4px; margin: 4px 0; }
.goods-seller { font-size: 11px; color: #999; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 10px; background: white; border-top: 1px solid #eee; }
.empty { padding: 60px 0; }
