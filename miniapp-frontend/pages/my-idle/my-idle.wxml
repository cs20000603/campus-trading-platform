<view class="container">
  <van-tabs active="{{ activeTab }}" bind:change="onTabChange">
    <van-tab title="在售"></van-tab>
    <van-tab title="已售出"></van-tab>
    <van-tab title="已下架"></van-tab>
  </van-tabs>

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">
    <van-empty description="暂无商品" />
  </view>

  <view class="list-wrap">
    <van-swipe-cell wx:for="{{list}}" wx:key="id" right-width="{{ activeTab === 0 ? 130 : (activeTab === 2 ? 130 : 65) }}">
      <view class="idle-item" data-id="{{item.id}}" bindtap="onItemTap">
        <image class="idle-img" src="{{item.images.split(',')[0]}}" mode="aspectFill" />
        <view class="idle-info">
          <view class="idle-title">{{item.title}}</view>
          <view class="idle-price">￥{{item.price}}
            <text class="idle-original" wx:if="{{item.originalPrice}}">￥{{item.originalPrice}}</text>
          </view>
          <view class="idle-meta">
            <van-tag size="mini" type="warning">{{item.condition}}</van-tag>
            <text class="idle-date">{{item.createTime}}</text>
          </view>
        </view>
      </view>
      <view slot="right" class="swipe-actions">
        <view class="swipe-btn down-btn" wx:if="{{activeTab === 0}}" data-id="{{item.id}}" catchtap="onTakeDown">下架</view>
        <view class="swipe-btn relist-btn" wx:if="{{activeTab === 2}}" data-id="{{item.id}}" catchtap="onRelist">上架</view>
        <view class="swipe-btn del-btn" data-id="{{item.id}}" catchtap="onDelete">删除</view>
      </view>
    </van-swipe-cell>
  </view>
</view>
