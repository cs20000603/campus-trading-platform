.container { padding-bottom: 20px; }
.empty { padding: 60px 0; }
.list-wrap { margin-top: 8px; }
.idle-item { display: flex; padding: 10px; background: white; border-bottom: 1px solid #f5f5f5; }
.idle-img { width: 80px; height: 80px; border-radius: 6px; flex-shrink: 0; }
.idle-info { flex: 1; margin-left: 10px; display: flex; flex-direction: column; justify-content: space-between; }
.idle-title { font-size: 14px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.idle-price { color: #ee0a24; font-size: 16px; font-weight: bold; }
.idle-original { color: #999; font-size: 11px; text-decoration: line-through; margin-left: 6px; font-weight: normal; }
.idle-meta { display: flex; align-items: center; gap: 6px; }
.idle-date { font-size: 11px; color: #999; }
.swipe-actions { display: flex; height: 100%; }
.swipe-btn { width: 65px; display: flex; align-items: center; justify-content: center; color: white; font-size: 13px; }
.down-btn { background: #ff976a; }
.relist-btn { background: #1989fa; }
.del-btn { background: #ee0a24; }
