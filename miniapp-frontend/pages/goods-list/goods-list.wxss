.goods-list-page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-wrap {
  padding: 0 10px;
  background-color: #fff;
}

/* Category Tabs */
.category-tabs {
  display: flex;
  white-space: nowrap;
  background-color: #fff;
  padding: 0 10px 10px;
  border-bottom: 1px solid #eee;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
  margin-right: 10px;
  font-size: 13px;
  color: #666;
  background-color: #f7f7f7;
  border-radius: 20px;
  flex-shrink: 0;
}

.category-tab.active {
  background-color: #ee0a24;
  color: #fff;
}

/* Goods Grid */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 10px;
  justify-content: space-between;
}

.goods-item {
  width: 48%;
  margin-bottom: 10px;
  background-color: #fff;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06);
}

.goods-image {
  width: 100%;
  height: 180px;
}

.goods-info {
  padding: 8px 10px;
}

.goods-name {
  font-size: 13px;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 6px;
  line-height: 1.4;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-bottom .price {
  color: #ee0a24;
  font-size: 15px;
  font-weight: bold;
}

.sale-text {
  font-size: 11px;
  color: #bbb;
}

.load-more {
  text-align: center;
  padding: 15px;
  color: #999;
  font-size: 13px;
}
