.collect-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.collect-card {
  display: flex;
  padding: 20rpx 30rpx;
  background-color: #fff;
}

.collect-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.collect-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.collect-price {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: bold;
}

.collect-time {
  font-size: 22rpx;
  color: #999;
}

.swipe-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 100%;
  background-color: #ee0a24;
  color: #fff;
  font-size: 26rpx;
}
