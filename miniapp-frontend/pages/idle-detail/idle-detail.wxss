.container { padding-bottom: 70px; }
.image-section { position: relative; }
.image-swiper { width: 100%; height: 375px; }
.detail-image { width: 100%; height: 100%; }
.image-counter { position: absolute; right: 10px; bottom: 10px; background: rgba(0,0,0,0.5); color: white; padding: 2px 8px; border-radius: 10px; font-size: 12px; }
.detail-header { padding: 12px; background: white; }
.detail-price { color: #ee0a24; font-size: 24px; font-weight: bold; }
.detail-original { color: #999; font-size: 13px; text-decoration: line-through; margin-left: 8px; font-weight: normal; }
.detail-title { font-size: 16px; margin: 6px 0; font-weight: 500; }
.detail-meta { display: flex; align-items: center; margin-top: 6px; }
.detail-views { font-size: 12px; color: #999; margin-left: auto; }
.seller-card { display: flex; align-items: center; padding: 12px; background: white; margin-top: 8px; }
.seller-avatar { width: 48px; height: 48px; border-radius: 50%; }
.seller-info { flex: 1; margin-left: 10px; }
.seller-name { font-size: 15px; font-weight: 500; }
.seller-shop { font-size: 12px; color: #1989fa; margin-top: 2px; }
.seller-area { font-size: 12px; color: #999; margin-top: 2px; }
.seller-time { font-size: 12px; color: #999; }
.desc-section { padding: 12px; background: white; margin-top: 8px; }
.section-title { font-size: 15px; font-weight: 500; margin-bottom: 8px; color: #333; }
.desc-content { font-size: 14px; color: #666; line-height: 1.6; white-space: pre-wrap; }
.status-section { margin-top: 8px; background: white; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 10px; padding: 10px; background: white; border-top: 1px solid #eee; justify-content: flex-end; }
