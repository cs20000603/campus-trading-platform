.search-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.search-bar-wrap {
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

/* Suggestion dropdown */
.suggest-dropdown {
  background: #fff;
  margin: 0 20rpx;
  border-radius: 0 0 12rpx 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.suggest-item {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.suggest-item:last-child {
  border-bottom: none;
}

.suggest-item text {
  margin-left: 16rpx;
}

.search-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

.loading-icon {
  animation: rotate 1s linear infinite;
  margin-right: 12rpx;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.search-results {
  padding: 10rpx;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
}

.goods-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goods-image {
  width: 100%;
  height: 340rpx;
}

.goods-info {
  padding: 16rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.goods-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.goods-price {
  color: #ee0a24;
  font-size: 32rpx;
  font-weight: bold;
}

.goods-sale {
  color: #999;
  font-size: 22rpx;
}

.search-placeholder {
  padding-top: 120rpx;
}
.ai-search-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 30rpx 40rpx;
  padding: 24rpx 30rpx;
  background: linear-gradient(135deg, #fff5f5, #fef0f0);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}
.ai-search-icon {
  margin-right: 12rpx;
}
.ai-search-tip text:nth-child(2) {
  flex: 1;
}
