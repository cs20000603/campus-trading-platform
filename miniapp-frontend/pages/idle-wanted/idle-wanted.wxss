.container { padding: 10px; }
.header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.header-title { font-size: 16px; font-weight: bold; }
.empty { padding: 60px 0; }
.wanted-item { background: white; border-radius: 8px; padding: 12px; margin-bottom: 10px; }
.wanted-top { display: flex; justify-content: space-between; align-items: center; }
.wanted-title { font-size: 15px; font-weight: 500; flex: 1; margin-right: 8px; }
.wanted-budget { color: #ee0a24; font-size: 18px; font-weight: bold; margin: 6px 0; }
.wanted-desc { font-size: 13px; color: #666; margin-bottom: 6px; }
.wanted-footer { display: flex; align-items: center; font-size: 12px; color: #999; }
.wanted-avatar { width: 22px; height: 22px; border-radius: 50%; margin-right: 4px; }
.wanted-name { margin-right: 4px; }
.wanted-area { color: #999; }
.wanted-time { margin-left: auto; margin-right: 8px; }
.wanted-del { color: #ee0a24; }
.publish-title { font-size: 16px; font-weight: bold; margin-bottom: 10px; text-align: center; }
.publish-btns { display: flex; gap: 10px; justify-content: flex-end; margin-top: 12px; }
