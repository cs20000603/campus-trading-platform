.user-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* User Header */
.user-header {
  display: flex;
  align-items: center;
  padding: 30px 20px;
  background: linear-gradient(135deg, #ee0a24 0%, #ff6034 100%);
  color: #fff;
}

.user-avatar {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  border: 3px solid rgba(255,255,255,0.5);
  margin-right: 15px;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 6px;
}

.user-account {
  font-size: 14px;
  opacity: 0.9;
}

.login-header {
  background: linear-gradient(135deg, #999 0%, #666 100%);
}

.login-tip {
  font-size: 13px;
  opacity: 0.8;
}

.login-btn {
  background-color: #fff;
  color: #ee0a24;
  padding: 8px 20px;
  border-radius: 20px;
  font-size: 13px;
}

/* Menu */
.menu-group {
  margin: 10px 0;
}

/* Logout */
.logout-wrap {
  padding: 30px 20px;
}

.logout-btn {
  color: #999 !important;
  border-color: #ddd !important;
}
