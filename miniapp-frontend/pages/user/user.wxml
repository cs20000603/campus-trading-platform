<view class="user-page">
  <!-- User Header -->
  <view class="user-header" wx:if="{{userInfo}}">
    <van-image
      class="user-avatar"
      src="{{userInfo.avatar || '/images/default-avatar.png'}}"
      fit="cover"
      width="70px"
      height="70px"
      radius="50%"
    />
    <view class="user-info">
      <view class="user-name">{{userInfo.name || userInfo.username || '用户'}}</view>
      <view class="user-account">余额: ¥{{userInfo.account || 0}}</view>
    </view>
  </view>

  <!-- Not Logged In -->
  <view class="user-header login-header" wx:else>
    <van-image
      class="user-avatar"
      src="/images/default-avatar.png"
      fit="cover"
      width="70px"
      height="70px"
      radius="50%"
    />
    <view class="user-info">
      <view class="user-name">未登录</view>
      <view class="login-tip">点击登录体验更多功能</view>
    </view>
    <navigator url="/pages/login/login" class="login-btn">登录</navigator>
  </view>

  <!-- Menu -->
  <van-cell-group custom-class="menu-group">
    <van-cell
      title="我的订单"
      icon="orders-o"
      is-link
      bind:click="onOrdersTap"
    />
    <van-cell
      title="我的收藏"
      icon="star-o"
      is-link
      bind:click="onCollectTap"
    />
    <van-cell
      title="我的评价"
      icon="comment-o"
      is-link
      bind:click="onCommentListTap"
    />
    <van-cell
      title="充值记录"
      icon="balance-o"
      is-link
      bind:click="onRechargeTap"
    />
  </van-cell-group>

  <van-cell-group custom-class="menu-group">
    <van-cell
      title="编辑资料"
      icon="user-o"
      is-link
      bind:click="onUserProfileTap"
    />
    <van-cell
      title="我的店铺"
      icon="shop-o"
      is-link
      bind:click="onShopTap"
    />
    <van-cell
      title="闲置广场"
      icon="exchange"
      is-link
      bind:click="onIdleTap"
    />
    <van-cell
      title="修改密码"
      icon="lock"
      is-link
      bind:click="onPasswordTap"
    />
  </van-cell-group>

  <van-cell-group custom-class="menu-group">
    <van-cell
      title="关于我们"
      icon="info-o"
      is-link
      bind:click="onAboutTap"
    />
  </van-cell-group>

  <!-- Logout -->
  <view class="logout-wrap" wx:if="{{userInfo}}">
    <van-button
      type="default"
      block
      custom-class="logout-btn"
      bind:click="onLogoutTap"
    >
      退出登录
    </van-button>
  </view>
</view>
