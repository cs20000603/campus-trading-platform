<view class="password-page">
  <van-cell-group>
    <van-field
      label="旧密码"
      value="{{oldPassword}}"
      type="password"
      placeholder="若无旧密码可留空"
      border="{{true}}"
      clearable
      bind:change="onOldPwdInput"
    />
    <van-field
      label="新密码"
      value="{{newPassword}}"
      type="password"
      placeholder="请输入新密码（至少6位）"
      border="{{true}}"
      clearable
      bind:change="onNewPwdInput"
    />
    <van-field
      label="确认密码"
      value="{{confirmPassword}}"
      type="password"
      placeholder="请再次输入新密码"
      border="{{true}}"
      clearable
      bind:change="onConfirmPwdInput"
    />
  </van-cell-group>

  <view class="tips">
    <text class="tip-text">密码长度至少6位，修改成功后需重新登录</text>
  </view>

  <view class="submit-wrapper">
    <van-button
      type="primary"
      block
      round
      loading="{{submitting}}"
      bind:click="onSubmit"
    >
      确认修改
    </van-button>
  </view>
</view>
