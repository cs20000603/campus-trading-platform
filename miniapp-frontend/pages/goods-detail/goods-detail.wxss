.goods-detail-page {
  background-color: #f5f5f5;
  padding-bottom: 60px;
  min-height: 100vh;
}

.goods-image-wrap {
  width: 100%;
  height: 375px;
}

.goods-image {
  width: 100%;
  height: 100%;
}

/* Product Info */
.goods-info-card {
  background-color: #fff;
  padding: 15px;
  margin-bottom: 10px;
}

.goods-name {
  font-size: 17px;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 10px;
}

.goods-price-row {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.goods-price-row .price {
  color: #ee0a24;
  font-size: 20px;
  font-weight: bold;
  margin-right: 10px;
}

.goods-sale {
  font-size: 12px;
  color: #999;
  margin-right: 12px;
}

.goods-stock {
  font-size: 12px;
  color: #999;
}

.goods-desc {
  font-size: 13px;
  color: #666;
  line-height: 1.5;
}

/* Stepper Row */
.stepper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 12px 15px;
  margin-bottom: 10px;
}

.stepper-label {
  font-size: 14px;
  color: #333;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  background-color: #fff;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 14px;
  color: #666;
  border-bottom: 2px solid transparent;
}

.tab-item.active {
  color: #ee0a24;
  border-bottom-color: #ee0a24;
  font-weight: bold;
}

/* Tab Content */
.tab-content {
  background-color: #fff;
  padding: 15px;
  min-height: 200px;
}

.goods-rich-text {
  font-size: 14px;
  line-height: 1.6;
}

/* Comments */
.comment-item {
  padding: 15px 0;
  border-bottom: 1px solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.comment-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  margin-right: 8px;
}

.comment-user-info {
  flex: 1;
}

.comment-name {
  font-size: 13px;
  color: #333;
  display: block;
  margin-bottom: 4px;
}

.comment-time {
  font-size: 11px;
  color: #ccc;
}

.comment-content {
  font-size: 14px;
  color: #333;
  line-height: 1.5;
  margin-top: 6px;
}

.comment-goods {
  display: flex;
  align-items: center;
  margin-top: 6px;
  background-color: #f9f9f9;
  padding: 6px;
  border-radius: 4px;
}

.comment-goods-img {
  width: 40px;
  height: 40px;
  border-radius: 4px;
  margin-right: 8px;
}

.comment-goods-name {
  font-size: 12px;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 15px;
  color: #999;
  font-size: 13px;
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 8px 15px;
  box-shadow: 0 -2px 8px rgba(0,0,0,0.08);
  z-index: 100;
}

.favorite-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 15px 0 0;
  border-right: 1px solid #eee;
  margin-right: 10px;
}

.favorite-text {
  font-size: 11px;
}

.cart-btn {
  flex: 1;
  background-color: #ff976a;
  color: #fff;
  text-align: center;
  padding: 12px 0;
  border-radius: 20px;
  font-size: 14px;
  margin-right: 10px;
  font-weight: 500;
}

.buy-btn {
  flex: 1;
  background-color: #ee0a24;
  color: #fff;
  text-align: center;
  padding: 12px 0;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
}
