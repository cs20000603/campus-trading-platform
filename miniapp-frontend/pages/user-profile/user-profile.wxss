.user-profile-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.avatar-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  background-color: #fff;
  margin-bottom: 16rpx;
}

.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-img {
  border: 4rpx solid #f0f0f0;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.balance-text {
  color: #ee0a24;
  font-weight: bold;
}

.submit-wrapper {
  padding: 40rpx 30rpx;
}
