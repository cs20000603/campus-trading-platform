.goods-manage-page {
  padding-bottom: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
}
.header-title {
  font-size: 30rpx;
  font-weight: bold;
}
.goods-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 2rpx;
}
.goods-img {
  flex-shrink: 0;
}
.goods-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.goods-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-price-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}
.goods-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #ee0a24;
}
.goods-meta {
  font-size: 22rpx;
  color: #999;
}
.goods-meta text {
  margin-right: 16rpx;
}
.goods-actions {
  flex-shrink: 0;
  margin-left: 20rpx;
}
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* Form overlay */
.form-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.form-container {
  background: #fff;
  width: 100%;
  max-height: 85vh;
  border-radius: 20rpx 20rpx 0 0;
  display: flex;
  flex-direction: column;
}
.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 32rpx;
  font-weight: bold;
}
.form-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}
.form-body {
  flex: 1;
  max-height: 55vh;
}
.form-footer {
  padding: 20rpx 30rpx 40rpx;
}
.picker-cell {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.picker-label {
  font-size: 28rpx;
  color: #333;
  width: 120rpx;
  flex-shrink: 0;
}
.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  text-align: right;
  margin-right: 10rpx;
}
.ai-btn-row {
  padding: 8rpx 30rpx 20rpx;
  display: flex;
  justify-content: flex-end;
}

.upload-wrap {
  padding: 20rpx 30rpx;
}
.upload-label {
  font-size: 28rpx;
  margin-bottom: 10rpx;
}
