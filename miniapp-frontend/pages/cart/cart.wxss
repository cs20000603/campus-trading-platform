.cart-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 70px;
}

/* Cart Item */
.cart-item {
  display: flex;
  align-items: center;
  padding: 12px 15px;
  background-color: #fff;
  margin-bottom: 1px;
}

.cart-checkbox {
  margin-right: 10px;
}

.cart-image {
  width: 80px;
  height: 80px;
  border-radius: 4px;
  margin-right: 10px;
  flex-shrink: 0;
}

.cart-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 60px;
}

.cart-name {
  font-size: 14px;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.cart-price {
  color: #ee0a24;
  font-size: 15px;
  font-weight: bold;
}

/* Delete Icon */
.delete-icon {
  padding: 10rpx;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
}

/* Delete Slot */
.delete-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70px;
  height: 100%;
  background-color: #ee0a24;
  color: #fff;
  font-size: 14px;
}

/* Swipe hint */
.swipe-hint {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 16rpx 0;
  background: #fff;
  margin-bottom: 1px;
}

/* Submit Bar */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 10px 15px;
  box-shadow: 0 -2px 8px rgba(0,0,0,0.08);
  z-index: 100;
}

.check-all {
  display: flex;
  align-items: center;
  margin-right: 10px;
}

.check-all-text {
  font-size: 14px;
  color: #333;
  margin-left: 6px;
}

.total-info {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 14px;
  color: #333;
}

.total-price {
  font-size: 18px;
  color: #ee0a24;
  font-weight: bold;
}

.checkout-btn {
  background-color: #ee0a24;
  color: #fff;
  padding: 10px 20px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: bold;
}

.checkout-btn.disabled {
  background-color: #ccc;
  color: #999;
}
