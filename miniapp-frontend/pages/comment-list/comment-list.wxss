.comment-list-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.search-wrap {
  background-color: #fff;
}

.comment-card {
  background-color: #fff;
  margin: 16rpx 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.comment-top {
  display: flex;
  align-items: center;
}

.comment-goods-info {
  margin-left: 20rpx;
  flex: 1;
}

.comment-goods-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.comment-order-no {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.comment-body {
  margin-top: 20rpx;
}

.comment-rate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 1.6;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* Edit popup */
.edit-popup-content {
  padding: 30rpx;
}

.edit-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
}

.edit-rate-wrapper {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.edit-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.edit-popup-btn {
  margin-top: 40rpx;
  padding: 0 20rpx;
}
