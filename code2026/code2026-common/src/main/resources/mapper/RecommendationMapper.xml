<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    XML声明：版本1.0，编码UTF-8
    DOCTYPE：MyBatis 3.0 Mapper DTD
-->
<!--
    mapper命名空间：映射到com.wll.common.mapper.RecommendationMapper接口
    推荐记录(Recommendation)数据访问层，负责商品推荐系统的数据管理
    用于存储系统向用户推荐商品的结果，以及用户对推荐的反馈信息
-->
<mapper namespace="com.wll.common.mapper.RecommendationMapper">

    <!--
        查询所有推荐记录（带分页和条件筛选）
        使用LEFT JOIN关联用户表和商品表，获取推荐相关的完整信息
        查询列说明：
          recommendation.* - 推荐记录表的所有列
          user.name        - 被推荐用户的名称（取别名userName）
          goods.name       - 被推荐商品的名称（取别名goodsName）
          goods.img        - 被推荐商品的图片（取别名goodsImg）
    -->
    <select id="selectAll" resultType="com.wll.common.entity.Recommendation">
        select recommendation.*, user.name as userName, goods.name as goodsName, goods.img as goodsImg
            from recommendation
            <!-- LEFT JOIN user：关联被推荐用户的信息 -->
            left join user on recommendation.user_id = user.id
            <!-- LEFT JOIN goods：关联被推荐商品的信息 -->
            left join goods on recommendation.goods_id = goods.id
        <where>
            <!-- 按用户ID筛选：查看推荐给某个用户的所有推荐记录 -->
            <if test="userId != null"> and recommendation.user_id = #{userId}</if>
            <!-- 按商品ID筛选：查看某个商品被推荐给了哪些用户 -->
            <if test="goodsId != null"> and recommendation.goods_id = #{goodsId}</if>
            <!-- 按商品名称模糊搜索 -->
            <if test="goodsName != null"> and goods.name like concat('%', #{goodsName}, '%')</if>
        </where>
        <!-- 按推荐记录id降序排列 -->
        order by recommendation.id desc
    </select>

    <!-- 按主键id查询单条推荐记录 -->
    <select id="selectById" resultType="com.wll.common.entity.Recommendation">
        select * from recommendation where id = #{id}
    </select>

    <!-- 按主键id删除推荐记录 -->
    <delete id="deleteById">
        delete from recommendation where id = #{id}
    </delete>

    <!--
        插入一条推荐记录（系统向用户推荐某商品时调用）
        useGeneratedKeys="true"：插入后自动获取数据库生成的主键id
        列说明：
          id       - 推荐记录唯一编号（主键，自动生成）
          user_id  - 被推荐用户ID（外键，关联user表，向谁推荐）
          goods_id - 被推荐商品ID（外键，关联goods表，推荐什么商品）
          reason   - 推荐理由（说明为什么推荐这个商品，如"根据您的浏览记录"）
          score    - 推荐评分（推荐算法给出的评分/置信度，数值越高推荐优先级越高）
          time     - 推荐时间
    -->
    <insert id="insert" parameterType="com.wll.common.entity.Recommendation" useGeneratedKeys="true">
        insert into recommendation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="reason != null">reason,</if>
            <if test="score != null">score,</if>
            <if test="time != null">time,</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <!-- #{reason}：推荐理由文本 -->
            <if test="reason != null">#{reason},</if>
            <!-- #{score}：推荐算法评分 -->
            <if test="score != null">#{score},</if>
            <if test="time != null">#{time},</if>
        </trim>
    </insert>

    <!--
        按主键id更新推荐记录
        可更新的字段：关联用户、关联商品、推荐理由、推荐评分、推荐时间
    -->
    <update id="updateById" parameterType="com.wll.common.entity.Recommendation">
        update recommendation
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="score != null">score = #{score},</if>
            <if test="time != null">time = #{time},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
